# ==============================================================================
# INTEGRATED LABORATORY EQUIPMENT MANAGEMENT SYSTEM (I-LEMS) - ENVIRONMENT CONFIG
# Copy this file to .env.local and fill in your actual values.
# ==============================================================================

# Supabase Database Configuration
# In Vite applications, client-accessible variables must start with VITE_.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gmail SMTP server configuration. Never prefix these with VITE_.
# Fill in the values in .env.local before testing email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=I-LEMS
SMTP_FROM_EMAIL=
